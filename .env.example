# -----------------------------------------------------------------------------
# ViewTube Environment Configuration Template
# Copy this file to .env and configure values for your environment
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development

# REST API & CORS
API_PREFIX=/api
CORS_ORIGIN=*
VITE_API_URL=/api

# Authentication (Change in production)
JWT_SECRET=viewtube_jwt_development_secret_key_change_in_production

# Database Connection (Optional PostgreSQL URI, falls back to in-memory store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viewtube_db

# Media Storage Directory
STORAGE_DIR=./public/videos
MAX_UPLOAD_SIZE_MB=50
